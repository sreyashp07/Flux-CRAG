# Copy this file to .env and adjust as needed:  cp .env.example .env

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.0

# --- Retrieval ---
COLLECTION_NAME=flux_crag_docs
RETRIEVAL_K=4

# --- Corrective RAG behaviour ---
MIN_RELEVANT_DOCS=1
MAX_REWRITE_ATTEMPTS=2
WEB_SEARCH_MAX_RESULTS=3

# --- Ingestion / chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Web search ---
# ddgs backend: auto, duckduckgo, bing, brave, google, yahoo, mojeek
WEB_SEARCH_BACKEND=auto
